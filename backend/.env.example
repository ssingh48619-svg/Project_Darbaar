# ==============================================================================
# DARBAAR LUXURY HOUSE & ADVISORY PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Server Network Configuration
PORT=5001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3001

# ------------------------------------------------------------------------------
# 1. MONGODB ATLAS CONFIGURATION
# ------------------------------------------------------------------------------
# Obtain from https://cloud.mongodb.com -> Database -> Connect -> Drivers
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/darbaar?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 2. CLOUDINARY MEDIA VAULT CONFIGURATION
# ------------------------------------------------------------------------------
# Obtain from https://console.cloudinary.com -> Dashboard -> API Keys
# Never expose these credentials to the frontend!
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 3. JWT & CRYPTOGRAPHIC SECURITY
# ------------------------------------------------------------------------------
# Generate locally using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_locally_generated_64_byte_crypto_hex_secret
JWT_EXPIRES_IN=7d
COOKIE_SECRET=your_locally_generated_cookie_salt_secret
